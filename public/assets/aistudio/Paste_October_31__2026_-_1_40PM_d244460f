        // --- REKAPITULASI LOGIC ---
        function renderRekapTable() {
            const tbody = document.getElementById('rekap-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            const counts = {};
            DAFTAR_SISWA_9C.forEach(nama => counts[nama] = { Hadir: 0, Izin: 0, Sakit: 0, Alpa: 0 });

            Object.keys(presensiData).forEach(dateKey => {
                const dayRecord = presensiData[dateKey];
                Object.keys(dayRecord).forEach(nama => {
                    if (counts[nama]) {
                        const st = dayRecord[nama];
                        if (counts[nama][st] !== undefined) counts[nama][st]++;
                    }
                });
            });

            DAFTAR_SISWA_9C.forEach((nama, idx) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/50 transition-colors";
                tr.innerHTML = `
