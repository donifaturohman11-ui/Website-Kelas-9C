        // --- UJIAN TKA RENDERING & NAVIGATION LOGIC ---
        function renderTKAQuestion() {
            const q = BANK_SOAL_TKA[currentTKAQuestionIdx];
            if (!q) return;

            document.getElementById('tka-q-category').innerText = q.category;
            document.getElementById('tka-q-number').innerText = currentTKAQuestionIdx + 1;
            document.getElementById('tka-q-text').innerText = q.question;

            const optsContainer = document.getElementById('tka-options-container');
            optsContainer.innerHTML = '';

            q.options.forEach((optText, optIdx) => {
                const isSelected = userTKAAnswers[currentTKAQuestionIdx] === optIdx;
                const div = document.createElement('div');
                div.className = `p-3.5 rounded-2xl border cursor-pointer transition-all flex items-center justify-between ${
                    isSelected 
                        ? 'bg-amber-500/20 border-amber-400 text-amber-200 font-bold shadow-lg' 
                        : 'bg-slate-900/60 border-slate-700/80 hover:bg-slate-800 text-slate-200'
                }`;
                div.onclick = () => selectTKAAnswer(optIdx);
                div.innerHTML = `
                    <span class="text-xs md:text-sm">${optText}</span>
                    <input type="radio" name="tka-opt" ${isSelected ? 'checked' : ''} class="accent-amber-400">
                `;
                optsContainer.appendChild(div);
            });

            // Toggle prev/next buttons
            const btnPrev = document.getElementById('btn-tka-prev');
            const btnNext = document.getElementById('btn-tka-next');
            if (btnPrev) btnPrev.style.visibility = currentTKAQuestionIdx === 0 ? 'hidden' : 'visible';
            if (btnNext) {
                if (currentTKAQuestionIdx === 29) {
                    btnNext.innerHTML = 'Selesai <i class="fas fa-check-circle ml-1"></i>';
                    btnNext.onclick = finishTKATest;
                } else {
                    btnNext.innerHTML = 'Selanjutnya <i class="fas fa-chevron-right ml-1"></i>';
                    btnNext.onclick = nextTKAQuestion;
                }
            }
        }

        function renderTKAGridNumbers() {
            const grid = document.getElementById('tka-grid-numbers');
            if (!grid) return;
            grid.innerHTML = '';

            let answeredCount = 0;
            userTKAAnswers.forEach(ans => { if (ans !== null) answeredCount++; });
            const countDisplay = document.getElementById('tka-answered-count');
            if (countDisplay) countDisplay.innerText = `${answeredCount}/30 Terjawab`;

            for (let i = 0; i < 30; i++) {
                const isAnswered = userTKAAnswers[i] !== null;
                const isCurrent = i === currentTKAQuestionIdx;

                const btn = document.createElement('button');
                btn.className = `py-2 rounded-xl font-bold text-xs transition-all ${
                    isCurrent
                        ? 'bg-amber-400 text-slate-950 ring-2 ring-amber-300 shadow-lg scale-105'
                        : isAnswered
                        ? 'bg-emerald-600 text-white'
                        : 'bg-slate-800 text-slate-400 hover:bg-slate-700'
                }`;
                btn.innerText = i + 1;
                btn.onclick = () => jumpToTKAQuestion(i);
                grid.appendChild(btn);
            }
        }

        function jumpToTKAQuestion(idx) {
            currentTKAQuestionIdx = idx;
            saveTKAProgress();
            renderTKAQuestion();
            renderTKAGridNumbers();
        }

        function nextTKAQuestion() {
            if (currentTKAQuestionIdx < 29) {
                currentTKAQuestionIdx++;
                saveTKAProgress();
                renderTKAQuestion();
                renderTKAGridNumbers();
            }
        }

        function prevTKAQuestion() {
            if (currentTKAQuestionIdx > 0) {
                currentTKAQuestionIdx--;
                saveTKAProgress();
                renderTKAQuestion();
                renderTKAGridNumbers();
            }
        }

        function startTKATest() {
            currentTKAQuestionIdx = 0;
            userTKAAnswers = new Array(30).fill(null);
            tkaSecondsLeft = 3600; // 1 Jam

            saveTKAProgress();

            document.getElementById('tka-start-container').classList.add('hidden');
            document.getElementById('tka-result-container').classList.add('hidden');
            document.getElementById('tka-exam-container').classList.remove('hidden');

            renderTKAGridNumbers();
            renderTKAQuestion();

            if (tkaTimerInterval) clearInterval(tkaTimerInterval);
            tkaTimerInterval = setInterval(updateTKATimer, 1000);
        }

        function updateTKATimer() {
            tkaSecondsLeft--;
            saveTKAProgress();

            if (tkaSecondsLeft <= 0) {
                clearInterval(tkaTimerInterval);
                finishTKATest();
                alert('Waktu ujian 1 Jam telah habis! Hasil ujian Anda telah dikirim secara otomatis.');
                return;
            }
            const mins = Math.floor(tkaSecondsLeft / 60);
            const secs = tkaSecondsLeft % 60;
            document.getElementById('tka-timer-display').innerText = 
                `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function selectTKAAnswer(optIdx) {
            userTKAAnswers[currentTKAQuestionIdx] = optIdx;
            saveTKAProgress();
            renderTKAQuestion();
            renderTKAGridNumbers();
        }

        function finishTKATest() {
            if (tkaTimerInterval) clearInterval(tkaTimerInterval);
            clearTKAProgress();

            let correct = 0;
            BANK_SOAL_TKA.forEach((q, idx) => {
                if (userTKAAnswers[idx] === q.answer) correct++;
            });

            const score = Math.round((correct / 30) * 100);
            const wrong = 30 - correct;

            document.getElementById('tka-exam-container').classList.add('hidden');
            document.getElementById('tka-result-container').classList.remove('hidden');

            document.getElementById('tka-result-score').innerText = score;
            document.getElementById('tka-result-correct').innerText = correct;
            document.getElementById('tka-result-wrong').innerText = wrong;
        }

