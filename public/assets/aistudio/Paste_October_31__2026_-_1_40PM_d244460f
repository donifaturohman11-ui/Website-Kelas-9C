        function postLinimasaStatus() {
            const text = document.getElementById('linimasa-input-text').value.trim();
            const author = document.getElementById('linimasa-input-author').value.trim() || 'Siswa 9C';
            if (!text) return;

            linimasaPosts.unshift({ id: Date.now(), author, text, time: 'Baru saja', likes: 0 });
            localStorage.setItem('linimasaPosts9C', JSON.stringify(linimasaPosts));
            document.getElementById('linimasa-input-text').value = '';
            renderLinimasaPosts();
        }

        function likeLinimasaPost(idx) {
            linimasaPosts[idx].likes++;
            localStorage.setItem('linimasaPosts9C', JSON.stringify(linimasaPosts));
            renderLinimasaPosts();
        }

        // --- GAME ARCADE SWITCHER & PUZZLE LOGIC ---
        function switchSubGame(gameName) {
            ['puzzle', 'tetris', 'mario', 'dungeon'].forEach(g => {
                const sec = document.getElementById('subgame-' + g);
                const btn = document.getElementById('btn-game-' + g);
                if (sec) sec.classList.add('hidden');
                if (btn) btn.className = "px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all";
            });
            const activeSec = document.getElementById('subgame-' + gameName);
            const activeBtn = document.getElementById('btn-game-' + gameName);
            if (activeSec) activeSec.classList.remove('hidden');
            if (activeBtn) activeBtn.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 transition-all shadow-lg";

            if (gameName === 'puzzle') initSlidePuzzle();
        }

        let puzzleState = [1, 2, 3, 4, 5, 6, 7, 8, 0];
        let puzzleMoves = 0;

        function initSlidePuzzle() {
            puzzleState = [1, 2, 3, 4, 5, 6, 7, 8, 0].sort(() => Math.random() - 0.5);
            puzzleMoves = 0;
            renderPuzzleGrid();
        }

        function renderPuzzleGrid() {
            const grid = document.getElementById('puzzle-grid');
            if (!grid) return;
            grid.innerHTML = '';
            document.getElementById('puzzle-moves').innerText = puzzleMoves;

            puzzleState.forEach((num, idx) => {
                const btn = document.createElement('button');
                btn.className = num === 0 ? "bg-slate-800/40 rounded-xl" : "bg-gradient-to-tr from-amber-500 to-orange-500 text-white font-extrabold text-xl rounded-xl shadow-lg flex items-center justify-center hover:scale-95 transition-all";
                btn.innerText = num === 0 ? '' : num;
                btn.onclick = () => movePuzzleTile(idx);
                grid.appendChild(btn);
            });
        }

        function movePuzzleTile(idx) {
            const emptyIdx = puzzleState.indexOf(0);
            const validMoves = [idx - 1, idx + 1, idx - 3, idx + 3];
            if (validMoves.includes(emptyIdx)) {
                puzzleState[emptyIdx] = puzzleState[idx];
                puzzleState[idx] = 0;
                puzzleMoves++;
                renderPuzzleGrid();
            }
        }

